{
  "name": "sci-agent",
  "version": "0.10.7",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "sci-agent",
      "version": "0.10.7",
      "license": "(MIT OR Apache-2.0)",
      "workspaces": [
        "packages/core",
        "packages/cli"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@sci/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@sci/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@sci/cli",
      "version": "0.10.7",
      "dependencies": {
        "@sci/core": "*"
      },
      "bin": {
        "sci-agent": "bin/sci-agent.js"
      }
    },
    "packages/core": {
      "name": "@sci/core",
      "version": "0.10.7"
    }
  }
}
